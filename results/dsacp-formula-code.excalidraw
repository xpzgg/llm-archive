      "width": 650,
      "height": 125,
      "fontSize": 22,
      "strokeColor": "#374151",
      "text": "1  构造 indexer K 和 head 权重\nkᴵ_s ← RoPE(LayerNorm(z_s W_K))\nw_t  ← scale · z_t W_w\n把本轮所有 kᴵ 写入 index K cache。",
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 200004,
