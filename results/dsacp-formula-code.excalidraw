    {
      "id": "s1_section",
      "type": "text",
      "x": 60,
      "y": 275,
      "width": 1630,
      "height": 65,
      "fontSize": 23,
      "strokeColor": "#374151",
      "text": "A  单层公式：x ← x + Attention(AttnNorm_i(x))；x ← x + FFN(FFNNorm_i(x))\nx 保留残差主路径；h 是临时结果。拆开后，下列每一行都与右边的调用对应。",
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 100008,
      "version": 1,
      "versionNonce": 200008,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A  单层公式：x ← x + Attention(AttnNorm_i(x))；x ← x + FFN(FFNNorm_i(x))\nx 保留残差主路径；h 是临时结果。拆开后，下列每一行都与右边的调用对应。",
      "autoResize": false,
      "lineHeight": 1.25
    },
