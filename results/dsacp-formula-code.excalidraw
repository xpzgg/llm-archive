      "versionNonce": 400005,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ForwardAttnIndexer:\n  XliteOpMatmul(..., indexKWeightsProj, kw, ...);\nForwardAttnIndexerCp 内：\n  XliteOpIndexerPrepare(..., begin, count);\n  // kw 合并 K 投影和 head 权重；Prepare 写 cache",
      "autoResize": false,
      "lineHeight": 1.25
    },
