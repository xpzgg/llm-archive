      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1  构造 indexer K 和 head 权重\nkᴵ_s ← RoPE(LayerNorm(z_s W_K))\nw_t  ← scale · z_t W_w\n把本轮所有 kᴵ 写入 index K cache。",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "s2_code_k",
      "type": "text",
      "x": 810,
      "y": 1150,
      "width": 905,
      "height": 131.25,
      "fontSize": 21,
      "strokeColor": "#ffffff",
      "text": "ForwardAttnIndexer:\n  XliteOpMatmul(..., indexKWeightsProj, kw, ...);\nForwardAttnIndexerCp 内：\n  XliteOpIndexerPrepare(..., begin, count);\n  // kw 合并 K 投影和 head 权重；Prepare 写 cache",
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 200005,
