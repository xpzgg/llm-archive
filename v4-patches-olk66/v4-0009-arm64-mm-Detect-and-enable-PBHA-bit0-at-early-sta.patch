From d6304f49b6b8d999a980ef4c7104ecc96ecd2597 Mon Sep 17 00:00:00 2001
From: Ma Wupeng <mawupeng1@huawei.com>
Date: Thu, 29 Oct 2026 17:55:01 +0800
Subject: [PATCH OLK-6.6 v4 09/18] arm64: mm: Detect and enable PBHA bit0 at
 early startup

hulk inclusion
category: feature
bugzilla: https://atomgit.com/openeuler/kernel/issues/9826

--------------------------------

Enable PBHA bit0 via FDT table at startup. PBHA bit 0 is currently needed
initialized.

Here is an example to enable PBHA bit0 in FDT table:

    cpus {
        arm,pbha-performance-only =
            <0x01000000 0x00000000 0x00000000 0x00000000>;
    };
    chosen {
        linux,pbha-bit0 = [0/1];
    };

Signed-off-by: Ma Wupeng <mawupeng1@huawei.com>
Signed-off-by: Fanhua Li <lifanhua5@huawei.com>
Signed-off-by: Jiacheng Yu <yujiacheng3@huawei.com>
---
 arch/arm64/Kconfig                 |  5 ++++
 arch/arm64/include/asm/setup.h     |  1 +
 arch/arm64/kernel/cpufeature.c     |  3 ++
 drivers/firmware/efi/libstub/fdt.c | 46 ++++++++++++++++++++++++++++++
 drivers/soc/hisilicon/Makefile     |  1 +
 drivers/soc/hisilicon/pbha.c       | 42 +++++++++++++++++++++++++++
 include/linux/pbha.h               | 30 +++++++++++++++++++
 7 files changed, 128 insertions(+)
 create mode 100644 drivers/soc/hisilicon/pbha.c
 create mode 100644 include/linux/pbha.h

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 39170028fd0f..56f05c78c9d4 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2209,6 +2209,11 @@ config ARM64_PBHA
 	  The behaviour of each PBHA bit is not defined. Say no unless you
 	  are very sure you want this
 
+	  For PBHA_BIT0: It has the following features:
+	  a) kernel pte entry will be set PBHA 59 bit during pagetable startup
+	  b) Introduce VM_PBHA_BIT0 for feature use.
+	  c) User pte entry will be set PBHA 59 bit for vma with VM_PBHA_BIT0.
+	  d) Introduce /proc/<pid>/pbha_bit0 to update whole user task.
 endmenu # "ARMv8.2 architectural features"
 
 menu "ARMv8.3 architectural features"
diff --git a/arch/arm64/include/asm/setup.h b/arch/arm64/include/asm/setup.h
index ac3bd8fc6b3e..90056f525c06 100644
--- a/arch/arm64/include/asm/setup.h
+++ b/arch/arm64/include/asm/setup.h
@@ -4,6 +4,7 @@
 #define __ARM64_ASM_SETUP_H
 
 #include <linux/string.h>
+#include <linux/cache.h>
 
 #include <uapi/asm/setup.h>
 
diff --git a/arch/arm64/kernel/cpufeature.c b/arch/arm64/kernel/cpufeature.c
index 5d4e259ac390..966bfac59cc8 100644
--- a/arch/arm64/kernel/cpufeature.c
+++ b/arch/arm64/kernel/cpufeature.c
@@ -78,6 +78,7 @@
 #include <linux/percpu.h>
 #include <linux/init.h>
 #include <linux/libfdt.h>
+#include <linux/pbha.h>
 
 #include <asm/actlr.h>
 #include <asm/cpu.h>
@@ -2254,6 +2255,8 @@ void __init early_pbha_init(void)
 	enable_pbha_inner();
 
 	pbha_enabled = true;
+
+	early_pbha_bit0_init();
 }
 
 /*
diff --git a/drivers/firmware/efi/libstub/fdt.c b/drivers/firmware/efi/libstub/fdt.c
index 6a337f1f8787..e304a36cf5e1 100644
--- a/drivers/firmware/efi/libstub/fdt.c
+++ b/drivers/firmware/efi/libstub/fdt.c
@@ -9,6 +9,8 @@
 
 #include <linux/efi.h>
 #include <linux/libfdt.h>
+#include <linux/pbha.h>
+
 #include <asm/efi.h>
 
 #include "efistub.h"
@@ -27,6 +29,47 @@ static void fdt_update_cell_size(void *fdt)
 	fdt_setprop_u32(fdt, offset, "#size-cells",    EFI_DT_SIZE_CELLS_DEFAULT);
 }
 
+#ifdef CONFIG_ARM64_PBHA
+static efi_status_t fdt_init_moc_mode(void *fdt, int node)
+{
+	efi_guid_t oem_config_guid = EFI_OEMCONFIG_VARIABLE_GUID;
+	unsigned long size;
+	efi_status_t efi_status;
+	u8 moc_mode;
+	int status;
+	u8 fdt_val32;
+	u8 arr[16] = { 0x1 };
+
+	efi_status = get_efi_var(L"MemoryOnChipMode", &oem_config_guid, NULL, &size,
+				 &moc_mode);
+	if (efi_status != EFI_SUCCESS)
+		goto out;
+
+	if (moc_mode != MOC_MODE_CACHE)
+		goto out;
+
+	fdt_val32 = 1;
+	status = fdt_setprop_var(fdt, node, "linux,pbha-bit0", fdt_val32);
+	if (status)
+		return EFI_LOAD_ERROR;
+
+	/* Current PBHA bit59 is need to enable PBHA bit0 mode. */
+	status = fdt_setprop_var(fdt, node, "arm,pbha-performance-only", arr);
+	if (status) {
+		efi_err("PBHA: arm,pbha-performance-only failed\n");
+		return EFI_LOAD_ERROR;
+	}
+
+out:
+	return EFI_SUCCESS;
+}
+#else
+static inline efi_status_t fdt_init_moc_mode(void *fdt, int node)
+{
+	return EFI_SUCCESS;
+}
+#endif
+
 static efi_status_t update_fdt(void *orig_fdt, unsigned long orig_fdt_size,
 			       void *fdt, int new_fdt_size, char *cmdline_ptr)
 {
@@ -132,6 +175,9 @@ static efi_status_t update_fdt(void *orig_fdt, unsigned long orig_fdt_size,
 		}
 	}
 
+	if (fdt_init_moc_mode(fdt, node) != EFI_SUCCESS)
+		goto fdt_set_fail;
+
 	/* Shrink the FDT back to its minimum size: */
 	fdt_pack(fdt);
 
diff --git a/drivers/soc/hisilicon/Makefile b/drivers/soc/hisilicon/Makefile
index 21f4bdb277ff..c2f01fa4862a 100644
--- a/drivers/soc/hisilicon/Makefile
+++ b/drivers/soc/hisilicon/Makefile
@@ -3,6 +3,7 @@ obj-$(CONFIG_KUNPENG_HCCS)	+= kunpeng_hccs.o
 
 obj-$(CONFIG_HISI_HBMDEV)	+= hisi_hbmdev.o
 obj-$(CONFIG_HISI_HBMCACHE)	+= hisi_hbmcache.o
+obj-$(CONFIG_ARM64_PBHA)		+= pbha.o
 
 obj-$(CONFIG_HISI_SOC_CACHE)	+= hisi_soc_cache_framework.o
 obj-$(CONFIG_HISI_SOC_HHA)	+= hisi_soc_hha.o
diff --git a/drivers/soc/hisilicon/pbha.c b/drivers/soc/hisilicon/pbha.c
new file mode 100644
index 000000000000..7e80dcf77607
--- /dev/null
+++ b/drivers/soc/hisilicon/pbha.c
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) Huawei Technologies Co., Ltd. 2023. All rights reserved.
+ */
+
+#define pr_fmt(fmt)	"pbha: " fmt
+
+#include <linux/init.h>
+#include <linux/libfdt.h>
+#include <linux/printk.h>
+#include <linux/cpufeature.h>
+#include <linux/cache.h>
+#include <asm/setup.h>
+
+#define MOC_MODE_CACHE	1
+
+bool __ro_after_init pbha_bit0_enabled;
+
+void __init early_pbha_bit0_init(void)
+{
+	const u8 *prop;
+	void *fdt;
+	int node;
+
+	/* Check whether PBHA is enabled or not. */
+	if (!system_supports_pbha())
+		return;
+
+	fdt = get_early_fdt_ptr();
+	if (!fdt)
+		return;
+
+	node = fdt_path_offset(fdt, "/chosen");
+	if (node < 0)
+		return;
+
+	prop = fdt_getprop(fdt, node, "linux,pbha-bit0", NULL);
+	if (!prop)
+		return;
+	if (*prop == MOC_MODE_CACHE)
+		pbha_bit0_enabled = true;
+}
diff --git a/include/linux/pbha.h b/include/linux/pbha.h
new file mode 100644
index 000000000000..87cfda8041bf
--- /dev/null
+++ b/include/linux/pbha.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Copyright (C) Huawei Technologies Co., Ltd. 2023. All rights reserved.
+ */
+#ifndef __LINUX_PBHA_H
+#define __LINUX_PBHA_H
+
+#include <linux/efi.h>
+#include <linux/libfdt.h>
+
+#define EFI_OEMCONFIG_VARIABLE_GUID                                            \
+	EFI_GUID(0x21f3b3c5, 0x946d, 0x41c1, 0x83, 0x8c, 0x19, 0x4e, 0x48,     \
+		 0xaa, 0x41, 0xe2)
+
+#define MOC_MODE_MEMORY	0
+#define MOC_MODE_CACHE	1
+
+#ifdef CONFIG_ARM64_PBHA
+extern bool __ro_after_init pbha_bit0_enabled;
+extern void __init early_pbha_bit0_init(void);
+
+static inline bool system_support_pbha_bit0(void)
+{
+	return pbha_bit0_enabled;
+}
+#else
+static inline bool system_support_pbha_bit0(void) { return false; }
+#endif
+
+#endif
