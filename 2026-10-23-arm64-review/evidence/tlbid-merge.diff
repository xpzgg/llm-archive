+#define __TLBI_DOMAIN(asid, domain)				\
+	({							\
+		unsigned long __ta = 0;				\
+		__ta |= FIELD_PREP(GENMASK_ULL(15, 0), domain);	\
+		__ta |= FIELD_PREP(GENMASK_ULL(63, 48), asid);	\
