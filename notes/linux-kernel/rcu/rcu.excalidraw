  },
  {
   "id": "50VjiQRj",
   "type": "text",
   "x": 1140,
   "y": 1280,
   "width": 431.19999999999976,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#dc2626",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
