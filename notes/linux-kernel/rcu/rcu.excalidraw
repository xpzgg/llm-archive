  {
   "id": "d65SqCh9",
   "type": "text",
   "x": 960,
   "y": 446,
   "width": 431.20000000000005,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#047857",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
