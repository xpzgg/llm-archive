  },
  {
   "id": "0APsEhGM",
   "type": "text",
   "x": 900,
   "y": 5127,
   "width": 434.20000000000033,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
