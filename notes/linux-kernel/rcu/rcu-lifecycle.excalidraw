  },
  {
   "id": "n6JroZYP",
   "type": "text",
   "x": 16.0,
   "y": 8448,
   "width": 399.0,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
