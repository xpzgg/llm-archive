  {
   "id": "hmYNkJnU",
   "type": "text",
   "x": 2406.0,
   "y": 4590,
   "width": 681.0,
   "height": 93.75,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
