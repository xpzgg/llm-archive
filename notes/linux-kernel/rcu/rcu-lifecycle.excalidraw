  {
   "id": "4pYsOv2H",
   "type": "text",
   "x": 4114,
   "y": 632,
   "width": 433.9999999999999,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0083",
