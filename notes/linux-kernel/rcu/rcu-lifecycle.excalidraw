  {
   "id": "aM1Z4sTF",
   "type": "text",
   "x": 1654,
   "y": 1472,
   "width": 475.9999999999998,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
