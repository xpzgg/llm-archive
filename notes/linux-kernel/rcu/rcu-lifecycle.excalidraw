   "link": null,
   "locked": false,
   "text": "怎么设计",
   "originalText": "怎么设计",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
