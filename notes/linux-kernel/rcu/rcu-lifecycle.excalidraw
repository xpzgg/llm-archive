  {
   "id": "3I0mFFXr",
   "type": "text",
   "x": 3414,
   "y": 632,
   "width": 470.39999999999975,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
