  {
   "id": "LsfsNPcj",
   "type": "text",
   "x": 954,
   "y": 822,
   "width": 492.7999999999996,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
