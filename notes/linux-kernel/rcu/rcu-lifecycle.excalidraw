   "link": null,
   "locked": false,
   "text": "机制 4 · EQS 与 FQS：不能自己上报的 CPU，由 GP kthread 远程判定和催促",
   "originalText": "机制 4 · EQS 与 FQS：不能自己上报的 CPU，由 GP kthread 远程判定和催促",
   "fontSize": 26,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
