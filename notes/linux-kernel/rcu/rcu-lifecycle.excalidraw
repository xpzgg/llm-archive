  {
   "id": "V9ZJsZtl",
   "type": "text",
   "x": 1654,
   "y": 822,
   "width": 419.9999999999998,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
