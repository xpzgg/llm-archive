  {
   "id": "lUIJAfGG",
   "type": "text",
   "x": 1654,
   "y": 632,
   "width": 417.1999999999997,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
