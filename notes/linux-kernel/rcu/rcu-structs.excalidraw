			"text": "使用者这边\nstruct foo {\n    int key;\n    struct rcu_head rcu;          /* 嵌在被保护的对象里 */\n};\n\n/* 回调里用 container_of 找回对象 */\nstatic void foo_free_cb(struct rcu_head *rh)\n{\n    kfree(container_of(rh, struct foo, rcu));\n}\ncall_rcu(&p->rcu, foo_free_cb);   /* 或直接 kfree_rcu(p, rcu); */",
