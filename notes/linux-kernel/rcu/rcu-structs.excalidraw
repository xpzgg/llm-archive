		{
			"id": "GGqFyDuc",
			"type": "text",
			"x": 0,
			"y": 60,
			"width": 1827.375,
			"height": 20,
			"angle": 0,
			"strokeColor": "#64748b",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
