			"link": null,
			"locked": false,
			"text": "include/linux/sched.h\nunion rcu_special {\n    struct {\n        u8 blocked;    /* 被抢占过，正挂在 blkd_tasks 上 */\n        u8 need_qs;    /* unlock 时要替本 CPU 报 QS */\n        u8 exp_hint;   /* expedited GP 在等它 */\n        u8 need_mb;\n    } b;\n    u32 s;             /* 一次判断四个标志是否全为 0 */\n};",
			"originalText": "include/linux/sched.h\nunion rcu_special {\n    struct {\n        u8 blocked;    /* 被抢占过，正挂在 blkd_tasks 上 */\n        u8 need_qs;    /* unlock 时要替本 CPU 报 QS */\n        u8 exp_hint;   /* expedited GP 在等它 */\n        u8 need_mb;\n    } b;\n    u32 s;             /* 一次判断四个标志是否全为 0 */\n};",
			"fontSize": 12,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"autoResize": true,
			"lineHeight": 1.25,
