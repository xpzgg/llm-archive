			"seed": 1034,
			"version": 1,
			"versionNonce": 7241,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1760000000000,
			"link": null,
			"locked": false,
			"text": "kernel/rcu/tree.c\nstatic struct rcu_state rcu_state = {\n    .level = { &rcu_state.node[0] },\n    .gp_state = RCU_GP_IDLE,\n    .gp_seq = (0UL - 300UL) << RCU_SEQ_CTR_SHIFT,\n    .name = RCU_NAME,   /* \"rcu_preempt\" 或 \"rcu_sched\" */\n    .exp_mutex = __MUTEX_INITIALIZER(...),\n    .ofl_lock = __ARCH_SPIN_LOCK_UNLOCKED,\n    ...\n};",
			"originalText": "kernel/rcu/tree.c\nstatic struct rcu_state rcu_state = {\n    .level = { &rcu_state.node[0] },\n    .gp_state = RCU_GP_IDLE,\n    .gp_seq = (0UL - 300UL) << RCU_SEQ_CTR_SHIFT,\n    .name = RCU_NAME,   /* \"rcu_preempt\" 或 \"rcu_sched\" */\n    .exp_mutex = __MUTEX_INITIALIZER(...),\n    .ofl_lock = __ARCH_SPIN_LOCK_UNLOCKED,\n    ...\n};",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"autoResize": true,
			"lineHeight": 1.25,
			"customData": {
				"name": "rs_init_c"
			},
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null
		},
		{
			"id": "AEHQo7SV",
			"type": "text",
			"x": 0,
			"y": 888.5,
			"width": 427.984375,
			"height": 65,
			"angle": 0,
			"strokeColor": "#64748b",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
