		{
			"id": "3707xorB",
			"type": "text",
			"x": 14,
			"y": 698,
			"width": 439.5625,
			"height": 162.5,
			"angle": 0,
			"strokeColor": "#374151",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
