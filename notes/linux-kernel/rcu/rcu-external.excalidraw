   "versionNonce": 9082,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "# 开 RCU 事件\ncd /sys/kernel/tracing\necho 1 > events/rcu/rcu_grace_period/enable\necho 1 > events/rcu/rcu_fqs/enable\ncat trace_pipe\n\n# 或用 trace-cmd\ntrace-cmd record \\\n  -e rcu:rcu_grace_period \\\n  -e rcu:rcu_quiescent_state_report\n\n# stall 时 panic，拿 vmcore\nsysctl -w kernel.panic_on_rcu_stall=1\n\n# vmcore 里先看\nrcu_state.gp_seq / gp_state / gp_activity\nper_cpu(rcu_data, N).gp_seq / cpu_no_qs\n\n# 跑 rcutorture（源码根目录）\ntools/testing/selftests/rcutorture/\n  bin/kvm.sh --allcpus --duration 10 \\\n  --configs TREE01",
   "originalText": "# 开 RCU 事件\ncd /sys/kernel/tracing\necho 1 > events/rcu/rcu_grace_period/enable\necho 1 > events/rcu/rcu_fqs/enable\ncat trace_pipe\n\n# 或用 trace-cmd\ntrace-cmd record \\\n  -e rcu:rcu_grace_period \\\n  -e rcu:rcu_quiescent_state_report\n\n# stall 时 panic，拿 vmcore\nsysctl -w kernel.panic_on_rcu_stall=1\n\n# vmcore 里先看\nrcu_state.gp_seq / gp_state / gp_activity\nper_cpu(rcu_data, N).gp_seq / cpu_no_qs\n\n# 跑 rcutorture（源码根目录）\ntools/testing/selftests/rcutorture/\n  bin/kvm.sh --allcpus --duration 10 \\\n  --configs TREE01",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
