   "text": "call_rcu(&obj->rcu, obj_free_cb);   /* 或 kfree_rcu(obj, rcu) */\n...\n/* 模块卸载 */\nunregister_everything();\nrcu_barrier();                     /* 等所有已登记回调执行完 */",
   "originalText": "call_rcu(&obj->rcu, obj_free_cb);   /* 或 kfree_rcu(obj, rcu) */\n...\n/* 模块卸载 */\nunregister_everything();\nrcu_barrier();                     /* 等所有已登记回调执行完 */",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
