   "text": "idx = srcu_read_lock(&my_srcu);\np = srcu_dereference(gp, &my_srcu);\nmay_sleep(p);\nsrcu_read_unlock(&my_srcu, idx);\n/* 更新侧 */\nsynchronize_srcu(&my_srcu);",
   "originalText": "idx = srcu_read_lock(&my_srcu);\np = srcu_dereference(gp, &my_srcu);\nmay_sleep(p);\nsrcu_read_unlock(&my_srcu, idx);\n/* 更新侧 */\nsynchronize_srcu(&my_srcu);",
