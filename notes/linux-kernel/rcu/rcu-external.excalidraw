  {
   "id": "7hpoQGoB",
   "type": "text",
   "x": 3554,
   "y": 3475.199999999999,
   "width": 335.40000000000026,
   "height": 357.5,
   "angle": 0,
   "strokeColor": "#22c55e",
   "backgroundColor": "transparent",
