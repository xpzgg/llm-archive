   "text": "rcu_read_lock();\nobj = lookup(key);\nif (obj && !refcount_inc_not_zero(&obj->ref))\n        obj = NULL;          /* 正在被释放，当作不存在 */\nrcu_read_unlock();\n/* 之后靠引用计数持有 obj */",
   "originalText": "rcu_read_lock();\nobj = lookup(key);\nif (obj && !refcount_inc_not_zero(&obj->ref))\n        obj = NULL;          /* 正在被释放，当作不存在 */\nrcu_read_unlock();\n/* 之后靠引用计数持有 obj */",
