   "text": "again:\nrcu_read_lock();\nobj = lookup(key);\nif (obj && refcount_inc_not_zero(&obj->ref) &&\n    obj->key != key) {       /* 内存已被复用成别的对象 */\n        put(obj); rcu_read_unlock(); goto again;\n}\nrcu_read_unlock();",
   "originalText": "again:\nrcu_read_lock();\nobj = lookup(key);\nif (obj && refcount_inc_not_zero(&obj->ref) &&\n    obj->key != key) {       /* 内存已被复用成别的对象 */\n        put(obj); rcu_read_unlock(); goto again;\n}\nrcu_read_unlock();",
