   "text": "spin_lock(&lock); list_del_rcu(&e->node); spin_unlock(&lock);\nkfree_rcu(e, rcu);\n/* 读侧 */\nrcu_read_lock();\nlist_for_each_entry_rcu(e, &head, node)\n        use(e);\nrcu_read_unlock();",
   "originalText": "spin_lock(&lock); list_del_rcu(&e->node); spin_unlock(&lock);\nkfree_rcu(e, rcu);\n/* 读侧 */\nrcu_read_lock();\nlist_for_each_entry_rcu(e, &head, node)\n        use(e);\nrcu_read_unlock();",
