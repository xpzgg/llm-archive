			"text": "和 LoyenWang 那张图（4.14、GICv2）的区别",
			"originalText": "和 LoyenWang 那张图（4.14、GICv2）的区别",
			"fontSize": 18,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"autoResize": true,
			"lineHeight": 1.25,
