   "index": "a0216",
   "roundness": null,
   "seed": 1216,
   "version": 1,
   "versionNonce": 8515,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "② 同一个钩子里 kick_pool()：worklist 非空且 nr_running == 0 → 唤醒空闲的 B → B 跑起来，nr_running 0→1",
   "originalText": "② 同一个钩子里 kick_pool()：worklist 非空且 nr_running == 0 → 唤醒空闲的 B → B 跑起来，nr_running 0→1",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "lUVRfHtr",
   "type": "text",
   "x": 0,
   "y": 2528,
   "width": 525.0,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
