   "text": "① A 睡下：schedule() 里调用 wq_worker_sleeping() → nr_running 1→0",
   "originalText": "① A 睡下：schedule() 里调用 wq_worker_sleeping() → nr_running 1→0",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "KRNAZd89",
   "type": "text",
   "x": 0,
   "y": 2500,
   "width": 870.0,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
