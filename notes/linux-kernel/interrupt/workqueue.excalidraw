   "versionNonce": 8522,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "③ A 醒来：wq_worker_running() → nr_running 1→2（短暂超过 1）",
   "originalText": "③ A 醒来：wq_worker_running() → nr_running 1→2（短暂超过 1）",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "6uz9ErDa",
   "type": "text",
   "x": 0,
   "y": 2556,
   "width": 771.0,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
