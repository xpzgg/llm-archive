  {
   "id": "wJnL1UhM",
   "type": "text",
   "x": 1060,
   "y": 1602,
   "width": 512.3999999999994,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0179",
   "roundness": null,
   "seed": 1179,
   "version": 1,
   "versionNonce": 8256,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "INIT_WORK(w, fn)                   初始化\nschedule_work(w)                   = queue_work(system_wq, w)\nqueue_delayed_work(wq, dw, delay)  过一段时间再入队\nflush_work(w)                      等它执行完\ncancel_work_sync(w)                取消并等待（卸载驱动时）\nalloc_workqueue(name, flags, max_active)   建自己的队列",
   "originalText": "INIT_WORK(w, fn)                   初始化\nschedule_work(w)                   = queue_work(system_wq, w)\nqueue_delayed_work(wq, dw, delay)  过一段时间再入队\nflush_work(w)                      等它执行完\ncancel_work_sync(w)                取消并等待（卸载驱动时）\nalloc_workqueue(name, flags, max_active)   建自己的队列",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
