  {
   "id": "YcPiIDwx",
   "type": "text",
   "x": 0,
   "y": 4090.799999999998,
   "width": 629.9999999999998,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
