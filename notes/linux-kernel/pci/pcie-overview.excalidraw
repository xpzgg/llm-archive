   }
  },
  {
   "id": "FwRvrgRy",
   "type": "text",
   "x": 1516,
   "y": 3389.599999999999,
   "width": 559.9999999999998,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0286",
   "roundness": null,
   "seed": 1286,
   "version": 1,
   "versionNonce": 9005,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "设备 A 发出的 TLP 地址落在设备 B 的 BAR 里 → 交换机直接转给 B，不经过内存。\n例：网卡直接读写 GPU 显存（GPUDirect RDMA）、NVMe 直接写 GPU。\n能不能走、走哪条路，取决于两者在树上的位置和交换机的 ACS 设置。\n内核里有 P2P DMA 框架：drivers/pci/p2pdma.c",
   "originalText": "设备 A 发出的 TLP 地址落在设备 B 的 BAR 里 → 交换机直接转给 B，不经过内存。\n例：网卡直接读写 GPU 显存（GPUDirect RDMA）、NVMe 直接写 GPU。\n能不能走、走哪条路，取决于两者在树上的位置和交换机的 ACS 设置。\n内核里有 P2P DMA 框架：drivers/pci/p2pdma.c",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "name": "cc_p2p_b"
   }
  },
