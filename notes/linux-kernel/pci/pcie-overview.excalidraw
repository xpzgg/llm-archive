  {
   "id": "fujJvR4k",
   "type": "text",
   "x": 14,
   "y": 1729.5,
   "width": 613.1999999999999,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
