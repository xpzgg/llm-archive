   "version": 1,
   "versionNonce": 7808,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "数据链路层（Data Link）：给 TLP 加序号和 CRC；ACK / NAK 出错重传；\n基于信用（credit）的流量控制：接收方有空间才发",
   "originalText": "数据链路层（Data Link）：给 TLP 加序号和 CRC；ACK / NAK 出错重传；\n基于信用（credit）的流量控制：接收方有空间才发",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "name": "c_l1_t"
   }
  },
