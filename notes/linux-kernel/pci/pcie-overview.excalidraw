   "versionNonce": 7829,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "发送时自上而下逐层封装，接收时自下而上逐层拆开",
   "originalText": "发送时自上而下逐层封装，接收时自下而上逐层拆开",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
