  {
   "id": "oXOSJZEG",
   "type": "text",
   "x": 1316,
   "y": 4074.399999999999,
   "width": 543.1999999999995,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
