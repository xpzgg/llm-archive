   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "还有：设备直接访问设备（P2P）",
   "originalText": "还有：设备直接访问设备（P2P）",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
