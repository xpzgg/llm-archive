   }
  },
  {
   "id": "gj1WaFdU",
   "type": "text",
   "x": 1316,
   "y": 4194.799999999999,
   "width": 529.1999999999998,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0357",
   "roundness": null,
   "seed": 1357,
   "version": 1,
   "versionNonce": 9502,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "NVIDIA 的 GPU 间私有互连，带宽远高于 PCIe，不走 PCIe 的枚举和配置体系；\n多卡机器上 GPU 之间常同时有 NVLink 和 PCIe 两条路",
   "originalText": "NVIDIA 的 GPU 间私有互连，带宽远高于 PCIe，不走 PCIe 的枚举和配置体系；\n多卡机器上 GPU 之间常同时有 NVLink 和 PCIe 两条路",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "name": "var3_b"
   }
  },
