  {
   "id": "3pnTI99U",
   "type": "text",
   "x": 1714,
   "y": 1698.5,
   "width": 666.3999999999993,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0117",
   "roundness": null,
   "seed": 1117,
   "version": 1,
   "versionNonce": 7822,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760000000000,
   "link": null,
   "locked": false,
   "text": "物理层（Physical）：差分串行 lane，x1 ~ x16 聚合；编码（8b/10b、128b/130b、PAM4 FLIT）\n上电后自动链路训练，协商速率和宽度（LTSSM）",
   "originalText": "物理层（Physical）：差分串行 lane，x1 ~ x16 聚合；编码（8b/10b、128b/130b、PAM4 FLIT）\n上电后自动链路训练，协商速率和宽度（LTSSM）",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "customData": {
    "name": "c_l2_t"
   }
  },
  {
   "id": "hGcaHGfz",
   "type": "text",
   "x": 1700,
   "y": 1782,
   "width": 322,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
