   }
  },
  {
   "id": "154TNstj",
   "type": "text",
   "x": 2196,
   "y": 2278,
   "width": 176.8,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e40af",
   "backgroundColor": "transparent",
