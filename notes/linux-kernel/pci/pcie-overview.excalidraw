  {
   "id": "B2x5Q4RJ",
   "type": "text",
   "x": 2196,
   "y": 1948,
   "width": 193.8,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
