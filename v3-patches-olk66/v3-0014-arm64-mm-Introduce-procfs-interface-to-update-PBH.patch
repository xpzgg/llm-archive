index f34e357e9f97..239f2f3f95ec 100644
--- a/fs/proc/base.c
+++ b/fs/proc/base.c
@@ -102,6 +102,7 @@
 #include <linux/resctrl.h>
 #include <linux/cn_proc.h>
 #include <linux/ksm.h>
